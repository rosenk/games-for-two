{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tic-tac-toe-matchmaker",
  "main": "matchmaker/worker.js",
  "compatibility_date": "2026-09-13",
  "vars": {
    "ALLOWED_ORIGINS": "https://rosenk.github.io"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "MATCHMAKER",
        "class_name": "MatchmakingQueue"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MatchmakingQueue"]
    }
  ]
}
